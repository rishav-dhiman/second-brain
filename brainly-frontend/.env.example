# Leave empty (or delete this file) to default to http://localhost:5000.
# In Docker the build uses an empty value so the app calls the API same-origin.
VITE_BACKEND_URL=http://localhost:5000

# Public URL of the deployed frontend. Used in generated share links.
# Defaults to window.location.origin when unset (fine for local dev).
# In production set it, e.g. VITE_APP_URL=https://secondbrain.vercel.app
VITE_APP_URL=
