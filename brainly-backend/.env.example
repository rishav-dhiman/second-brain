# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API server listens on
PORT=5000

# MongoDB connection string (required)
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/brainly

# JWT signing secret (required).
# Use a long random value in production (32+ chars), e.g. `openssl rand -base64 48`
JWT_PASSWORD=change_me_to_a_long_random_secret

# How long issued tokens stay valid (zeit/ms format: 60s, 15m, 24h, 7d)
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Set to true to disable rate limiting (used by automated tests)
RATE_LIMIT_DISABLED=false
